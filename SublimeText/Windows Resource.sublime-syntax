%YAML 1.2
---
name: Windows Resource
scope: source.rc
extends: Packages/C++/C++.sublime-syntax

file_extensions:
  - rc
  - rc2
  - dlg

contexts:
  prototype:
    - meta_prepend: true
    - match: \b(DIALOG|DIALOGEX|MENU|MENUEX|POPUP|MENUITEM|SEPARATOR|STRINGTABLE|ACCELERATORS|TOOLBAR|VERSIONINFO|BITMAP|ICON|CURSOR|RCDATA|TEXTINCLUDE|DESIGNINFO|AFX_DIALOG_LAYOUT|HTML|MANIFEST|TYPELIB|REGISTRY|BEGIN|END|BLOCK|VALUE|FILEVERSION|PRODUCTVERSION|FILEFLAGSMASK|FILEFLAGS|FILEOS|FILETYPE|FILESUBTYPE|CAPTION|STYLE|EXSTYLE|FONT|CLASS|LANGUAGE|CHARACTERISTICS|VERSION|GUIDELINES|LEFTMARGIN|RIGHTMARGIN|TOPMARGIN|BOTTOMMARGIN|HORZGUIDE|VERTGUIDE|BUTTON|BLOCK)\b
      scope: keyword.declaration.resource.rc
    - match: \b(CONTROL|LTEXT|RTEXT|CTEXT|PUSHBUTTON|DEFPUSHBUTTON|CHECKBOX|AUTOCHECKBOX|RADIOBUTTON|AUTORADIOBUTTON|AUTO3STATE|STATE3|GROUPBOX|EDITTEXT|COMBOBOX|LISTBOX|SCROLLBAR|PUSHBOX)\b
      scope: entity.name.tag.control.rc
    - match: \b(WS|DS|ES|BS|SS|LBS|CBS|SBS|TBS|TCS|LVS|TVS|PBS|UDS|RBS|TTS|DTS|MCS|ACS|IDC|IDD|IDR|IDS|IDB|IDI|ID|AFX_IDS|AFX_IDD|VIRTKEY|ALT|SHIFT|CONTROL|NOINVERT|ASCII)_?[A-Z0-9_]*\b
      scope: constant.other.style.rc
