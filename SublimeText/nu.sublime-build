{
  "cmd": [
    "nu.exe",
    "$file"
  ],
  "selector": "source.shell.nu",
  "variants": [
    {
      "name": "Run",
      "shell": true,
      "quiet": false,
      "encoding": "utf-8",
      "cancel": {"kill": true},
      "working_dir": "$file_path",
      "env": {
        "NO_COLOR": "1"
      },
      "cmd": [
        "nu.exe",
        "--config",
        "$packages/User/no-ansi.nu",
        "$file"
      ]
    }
  ]
}
